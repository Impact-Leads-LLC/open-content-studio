# Every setting the studio reads. On Vercel: Project > Settings > Environment Variables, then redeploy (settings only
# load on a deploy). For the scripts in app/scripts and engines/upload.mjs, copy this file to app/.env.local and fill in
# the Supabase pair. Never commit .env.local, and never paste a key into a chat. ACCESS.md says where each one comes from.

# ---- Required

# Supabase: Project Settings > API. The project URL, and the SECRET key (sb_secret_...) or the legacy service_role key.
# Never the publishable or anon key.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Claude: console.anthropic.com > API keys. Every writer, the coach and the cloud editors use it.
ANTHROPIC_API_KEY=

# The brain connector (BRAIN.md): the studio-brain edge function's address and one of the tokens in its
# STUDIO_BRAIN_TOKENS secret. Or your own second brain's MCP address and token, if it answers the same tools.
# https://<project ref>.supabase.co/functions/v1/studio-brain/mcp (the setup fills it in)
BRAIN_MCP_URL=
BRAIN_MCP_TOKEN=

# Which scheduler: contentstudio or metricool post straight from the app (fill in that one's settings below). export, the
# default, is for any other tool (Flick, Buffer, Later, Hootsuite...): every piece has a posting kit to upload by hand and
# the calendar downloads as a CSV for a bulk upload. Put the tool's name in brand/studio.json as schedulerName.
SCHEDULER=export

# Vercel Cron's secret for the daily cleanup (/api/cron/retention). Any long random string; Vercel sends it as a bearer
# token with every cron call, and the route refuses anything else.
CRON_SECRET=

# ---- The scheduler (one of the two)

# ContentStudio: Settings > API keys (a plan with API access).
CONTENTSTUDIO_API_KEY=
# The workspace to post to, when the key sees more than one (its id is in the workspace's address in ContentStudio).
CONTENTSTUDIO_WORKSPACE_ID=
# Optional: workspace names (or parts of names), comma separated, this studio must never post to, e.g. another brand's.
CONTENTSTUDIO_SKIP_WORKSPACES=
# Optional: only if ContentStudio moves its API.
# CONTENTSTUDIO_API_BASE=https://api.contentstudio.io

# Metricool (Advanced plan or above): Account settings > API for the token. userId and blogId are in the address bar
# of app.metricool.com (?blogId=...&userId=...). blogId can be left out when the account has a single brand.
METRICOOL_API_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=

# Optional, either scheduler: where a network has two accounts, the one to post to, by the name the scheduler shows,
# e.g. facebook=Alex Rivera, linkedin=Alex Rivera Studio
SCHEDULER_PREFER_ACCOUNTS=

# ---- Optional

# Days after a piece goes out before its media files leave storage (RETENTION.md). Default 7; "off" turns it off.
RETENTION_DAYS=7

# Where the bottom-of-funnel offer is booked (overrides bookingUrl in brand/studio.json).
BOOKING_URL=

# Google Drive copies of every scheduled piece, and before the cleanup clears its files: the whole JSON key of a service
# account that is a Content manager on a shared drive, and the folder's id (or its full address).
GOOGLE_DRIVE_KEY=
DRIVE_FOLDER_ID=

# fal.ai: a generated cover picture for carousels with no episode still (an object or a place, never a person).
FAL_KEY=
# FAL_IMAGE_MODEL=fal-ai/flux-pro/v1.1

# The Claude model (default claude-opus-5-5, or "model" in brand/studio.json).
# CLAUDE_MODEL=claude-opus-5-5

# The podcast feed's address until a show has its own (Podcast page). Default: this deployment's production address.
# PODCAST_BASE_URL=https://studio.example.com
